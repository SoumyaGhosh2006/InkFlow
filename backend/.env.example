# ==============================================================================
# InkFlow Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the FastAPI server.
# Ensure that production secrets are injected securely via vault or deployment environment variables.
# ==============================================================================

# Project & Environment
PROJECT_NAME="InkFlow API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure 32-byte secret using: openssl rand -hex 32
SECRET_KEY="replace-with-a-robust-secret-key-for-inkflow-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase Authentication (Backend Verification)
# The backend only needs the Firebase Project ID to verify incoming Firebase JWT ID tokens.
# Client-side API keys (apiKey, authDomain, etc.) belong in frontend/.env.
FIREBASE_PROJECT_ID="inkflow-cluster"

# Database Configuration (Async MongoDB via Motor)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="inkflow"

# Two-Tier Groq LLM Configuration:
# Primary Model: openai/gpt-oss-120b (high-precision stylistic rewrite)
# Fallback Model: openai/gpt-oss-20b (blazing fast failover resilience)
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_API_KEY="gsk_replace_with_your_groq_api_key"
GROQ_PRIMARY_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# Granular Timeouts
PRIMARY_CONNECT_TIMEOUT=2.5
PRIMARY_READ_TIMEOUT=9.0
FALLBACK_CONNECT_TIMEOUT=2.0
FALLBACK_READ_TIMEOUT=8.0

# Usage Quotas & Limits
# Free tier allows up to 1,500 words per day, resetting daily at 00:00 UTC
FREE_TIER_DAILY_WORD_LIMIT=1500
FREE_TIER_WEEKLY_WORD_LIMIT=1500

# Observability
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0

# Payments & Monetization (Razorpay)
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_example"
RAZORPAY_KEY_SECRET="rzp_secret_example"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
