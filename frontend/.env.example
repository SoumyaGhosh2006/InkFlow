# ==============================================================================
# InkFlow Frontend Environment Variables (.env.example)
# ==============================================================================

# API Base URL
# Local FastAPI backend:
VITE_API_URL=http://localhost:8000/api/v1
# Production Web Service (e.g. Render):
# VITE_API_URL=https://inkflow-backend.onrender.com/api/v1

# Firebase Authentication (Client-side Web SDK)
# Find these in Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSy_your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="inkflow-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="inkflow-app"
VITE_FIREBASE_STORAGE_BUCKET="inkflow-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
