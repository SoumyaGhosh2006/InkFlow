# ==========================================
# InkFlow Unified .gitignore
# ==========================================

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# 2. Frontend (Node / Vite / React)
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Backend (Python / FastAPI / Pytest)
backend/venv/
backend/.venv/
venv/
.venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 4. OS & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.log