# ==============================================================================
# InkFlow .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env*.local
.env.production
.env.staging
# Keep the example template tracked in Git
!.env.example

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend dependencies (Next.js / React)
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database / Local storage
*.sqlite3
*.db
mongo-data/

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo